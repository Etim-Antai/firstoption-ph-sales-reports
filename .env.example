# FirstOption Solar Energy Company - Environment Configuration
# Free-tier friendly: 100% free with Supabase Free Tier + GitHub Pages

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (safe for browser client-side use)
# NEVER put your service_role secret key in this frontend file.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note: If these values are left empty or untouched, the application will
# gracefully run in Local Sandbox mode with the 203 verified company sales records!
